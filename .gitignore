.DS_Store

# Jupytext pairs.
#
# The .ipynb is the version in git, outputs and all, because the outputs are
# the point of these notebooks. The paired script is generated from it on
# demand and is never committed. The `.nb.py` suffix lets this one line ignore
# it without touching ordinary Python files, which are tracked normally.
*.nb.py

# Secrets
.env

# Rendered site (built by CI, and locally for previewing)
_site/

# Environments and caches
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Notebook run artifacts
.mem0-run/

# Downloaded datasets and model-call caches: regenerable, and large.
data/
.cache/

# Personal working notes. Never published with the repository.
private/
*.egg-info/

# Servers the experiment builds from source (infra/*/up.sh)
vendor/

# Run logs
results/*/_logs/

# Written by the Letta server into its working directory at startup
openapi_letta.json

# Notes taken in lectern while reading. Personal, never published.
*.notes.json
