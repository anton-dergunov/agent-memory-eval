# Honcho server settings for the experiment. `infra/honcho/up.sh` copies this to
# vendor/honcho/.env with @PROXY@ replaced by the experiment's proxy URL.
#
# Every model role points at the same model through memeval.proxy, which counts
# and caches the calls. Anything not set here is Honcho's own default.

AUTH_USE_AUTH=false
LOG_LEVEL=INFO
LLM_OPENAI_API_KEY=proxy
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false

EMBEDDING_VECTOR_DIMENSIONS=1536
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=gemini-embedding-001
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@

DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=@MODEL@
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
# The deriver waits until a batch holds 512 tokens or is 30 minutes old. The
# last messages of a history are usually below the token gate, so without this
# the run would sit idle for half an hour per question. Batch composition is
# otherwise unchanged.
DERIVER_REPRESENTATION_BATCH_MAX_AGE_SECONDS=30

SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=@MODEL@
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@

DREAM_ENABLED=true
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=@MODEL@
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=@MODEL@
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@

# The dialectic picks its model per reasoning level, and the generic dialectic
# model settings do not reach that structure: every level has to be set, or the
# levels left out call the upstream default model and fail.
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=@MODEL@
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=@MODEL@
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=@MODEL@
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=@MODEL@
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=@MODEL@
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=@PROXY@
# The dialectic otherwise pastes recent raw messages into its own prompt, which
# would hand it the conversation rather than the memory.
DIALECTIC_SESSION_HISTORY_MAX_TOKENS=0
